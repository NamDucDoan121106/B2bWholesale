@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-wrap d-flex align-items-center justify-content-center">
    <div class="card login-card">
        <div class="login-hero p-4 text-center">
            <i class="bi bi-boxes display-5"></i>
            <h1 class="h4 mt-2 mb-0">B2B Agent Portal</h1>
            <div class="small opacity-75">Wholesale ordering for registered distributor agents</div>
        </div>
        <div class="card-body p-4">
            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus placeholder="e.g. agent01" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <button class="btn btn-outline-secondary" type="button" id="togglePwd" title="Show / hide password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-portal w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                </button>
            </form>
            <p class="small text-muted mt-3 mb-0 text-center">
                Accounts lock after 5 wrong passwords. Contact the warehouse office to unlock.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePwd').addEventListener('click', function () {
            const input = document.getElementById('Password');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    </script>
}
