@model Order
@{
    ViewData["Title"] = $"Order #{Model.OrderID}";
    string[] flow = { OrderStatuses.Pending, OrderStatuses.Confirmed, OrderStatuses.Shipped, OrderStatuses.Delivered };
    var step = Array.IndexOf(flow, Model.OrderStatus);
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> My orders</a>
        <h1 class="h3 page-title mb-0">Order #@Model.OrderID <partial name="_StatusBadge" model="Model.OrderStatus" /></h1>
        <div class="text-muted">Placed on @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Invoice" asp-route-id="@Model.OrderID" target="_blank" class="btn btn-success"><i class="bi bi-printer me-1"></i>Printable invoice</a>
        @if (Model.OrderStatus == OrderStatuses.Pending)
        {
            <form asp-action="Cancel" asp-route-id="@Model.OrderID" method="post" onsubmit="return confirm('Cancel this order? The reserved stock will be released.');">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>Cancel order</button>
            </form>
        }
    </div>
</div>

@if (Model.OrderStatus != OrderStatuses.Cancelled)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row text-center g-2">
                @for (var i = 0; i < flow.Length; i++)
                {
                    var done = i <= step;
                    <div class="col-3">
                        <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center @(done ? "bg-portal text-white" : "bg-light text-muted")" style="width:42px;height:42px">
                            <i class="bi @StatusUi.Icon(flow[i])"></i>
                        </div>
                        <div class="small mt-1 @(done ? "fw-semibold" : "text-muted")">@flow[i]</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><i class="bi bi-list-ol me-1"></i>Order lines</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>#</th><th>Item</th><th>Packing / size</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Line total</th></tr>
                </thead>
                <tbody>
                @{ var n = 0; }
                @foreach (var d in Model.OrderDetails.OrderBy(x => x.ID))
                {
                    n++;
                    <tr>
                        <td>@n</td>
                        <td class="fw-semibold">@d.Item?.ItemName</td>
                        <td>@d.Item?.Size</td>
                        <td class="text-end">@d.Quantity.ToString("N0")</td>
                        <td class="text-end">@StatusUi.Money(d.UnitAmount)</td>
                        <td class="text-end">@StatusUi.Money(d.LineTotal)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="5" class="text-end">Order total (excl. VAT)</td>
                        <td class="text-end text-portal">@StatusUi.Money(Model.TotalAmount)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
