@model string
@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request. Please try again.</p>
    @if (!string.IsNullOrEmpty(Model))
    {
        <p class="small text-muted">Request ID: <code>@Model</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-portal">Back to dashboard</a>
</div>
