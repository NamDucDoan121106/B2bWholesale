@model HomeViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 page-title mb-0">Welcome, @Model.AgentName</h1>
        <div class="text-muted">Here is a summary of your wholesale account.</div>
    </div>
    <a asp-controller="Orders" asp-action="Create" class="btn btn-portal"><i class="bi bi-cart-plus me-1"></i>Place a new order</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-receipt"></i></span>
            <div><div class="text-muted small">Total orders</div><div class="stat-value">@Model.TotalOrders</div></div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i></span>
            <div><div class="text-muted small">Open orders</div><div class="stat-value">@Model.OpenOrders</div></div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-success-subtle text-success"><i class="bi bi-cash-stack"></i></span>
            <div><div class="text-muted small">Total purchased</div><div class="stat-value">@StatusUi.Money(Model.TotalSpent)</div></div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon bg-info-subtle text-info"><i class="bi bi-grid-3x3-gap"></i></span>
            <div><div class="text-muted small">Items in stock</div><div class="stat-value">@Model.CatalogCount</div></div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i>Recent orders</span>
        <a asp-controller="Orders" asp-action="Index" class="small">View all</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentOrders.Count == 0)
        {
            <div class="p-4 text-center text-muted">You have not placed any orders yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Order #</th><th>Date</th><th>Status</th><th class="text-end">Units</th><th class="text-end">Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td class="fw-semibold">#@o.OrderID</td>
                            <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><partial name="_StatusBadge" model="o.OrderStatus" /></td>
                            <td class="text-end">@o.Units.ToString("N0")</td>
                            <td class="text-end">@StatusUi.Money(o.Total)</td>
                            <td class="text-end"><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderID" class="btn btn-sm btn-outline-primary">Details</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
